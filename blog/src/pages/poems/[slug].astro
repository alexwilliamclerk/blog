---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const poemsAll = await getCollection("poems");
  const sorted = poemsAll
    .filter((p) => !p.data?.draft)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return sorted.map((poem, index) => ({
    params: { slug: poem.slug },
    props: { 
      poem,
      prev: index > 0 ? sorted[index - 1] : null,
      next: index < sorted.length - 1 ? sorted[index + 1] : null
    },
  }));
}

const { poem, prev, next } = Astro.props;
const { Content } = await poem.render();
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{poem.data.title} · 诗歌</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #f9f9f9;
        --card-bg: #ffffff;
        --text-main: #1a1a1a;
        --text-sub: #999999;
        --accent: #10b981;
        --border: #eeeeee;
      }
      body { background: var(--bg); color: var(--text-main); font-family: -apple-system, system-ui, sans-serif; margin: 0; padding: 20px; }
      .container { max-width: 650px; margin: 0 auto; padding-top: 30px; padding-bottom: 60px; }
      
      .poem-wrapper { background: var(--card-bg); padding: 60px 40px; border-radius: 24px; border: 1px solid var(--border); box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05); }
      
      /* 头部间距微调 */
      header { text-align: center; margin-bottom: 30px; }
      .title { font-family: 'Noto Serif SC', serif; font-size: 2.2rem; margin: 0 0 10px 0; }
      .meta { font-size: 13px; color: var(--text-sub); } 

      /* 正文核心逻辑：解决换行问题 */
      .article-content {
        font-family: 'Noto Serif SC', serif;
        font-size: 1.15rem;
        color: #333;
        text-align: center;
        line-height: 1.8;
        /* 魔法指令：强制保留 Markdown 中的原始换行 */
        white-space: pre-wrap; 
      }

      /* 既然保留了原始换行，段落间距就要适中，不能太大 */
      .article-content :global(p) {
        margin-top: 0;
        margin-bottom: 1.5em; /* 这里控制大段落（空行后）的距离 */
      }

      /* 控制第一行诗离日期的距离 */
      .article-content :global(p:first-child) {
        margin-top: 20px; 
      }

      /* 对称导航 */
      .pagination { display: flex; justify-content: space-between; margin-top: 40px; gap: 15px; }
      .nav-link { flex: 1; padding: 18px; background: #fff; border: 1px solid var(--border); border-radius: 16px; text-decoration: none; color: var(--text-main); transition: 0.3s; }
      .nav-link:hover { border-color: var(--accent); transform: translateY(-2px); }
      .nav-label { font-size: 11px; color: var(--text-sub); display: block; margin-bottom: 4px; }
      .nav-title { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
      .back-center { align-self: center; padding: 10px 20px; background: #eee; border-radius: 30px; font-size: 13px; text-decoration: none; color: #666; }
    </style>
  </head>
  <body>
    <div class="container">
      <article class="poem-wrapper">
        <header>
          <h1 class="title">{poem.data.title}</h1>
          <div class="meta">{new Date(poem.data.date).toLocaleDateString('zh-CN')}</div>
        </header>
        <div class="article-content"><Content /></div>
      </article>

      <div class="pagination">
        {prev ? (
          <a href={`/poems/${prev.slug}`} class="nav-link">
            <span class="nav-label">← 上一篇</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <div style="flex:1"></div>}
        <a href="/poems" class="back-center">列表</a>
        {next ? (
          <a href={`/poems/${next.slug}`} class="nav-link" style="text-align:right">
            <span class="nav-label">下一篇 →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        ) : <div style="flex:1"></div>}
      </div>
    </div>
  </body>
</html>
// 6. 核心 LOVE 滚动动画场景 (The Spectacular Scroll Animation)
// ==========================================
const LoveScrollSequence = ({ profile }: { profile: typeof MOCK_PROFILE }) => {
  const containerRef = useRef<HTMLDivElement>(null);
  const { scrollYProgress } = useScroll({ target: containerRef });

  // 极度精细的滚动映射逻辑
  
  // 阶段 1: (0 -> 0.4) 浅蓝色遮罩由上往下扫过，显示 LOVE 镂空
  const clipPathInset = useTransform(scrollYProgress, [0, 0.4], [100, 0]);
  const clipPathString = useTransform(clipPathInset, val => `inset(${val}% 0 0 0)`);
  
  // 阶段 2: (0.1 -> 0.3) Alex 文字提前淡出
  const textOpacity = useTransform(scrollYProgress, [0.1, 0.3], [1, 0]);
  const textScale = useTransform(scrollYProgress, [0, 0.3], [1, 0.95]);

  // 阶段 3: (0.6 -> 0.8) 包含 LOVE 的方块整体缩小并淡出，融入深色背景
  const boxScale = useTransform(scrollYProgress, [0.6, 0.8], [1, 0.85]);
  const boxOpacity = useTransform(scrollYProgress, [0.6, 0.8], [1, 0]);
  
  // 阶段 4: (0.75 -> 1.0) 真实主页内容从下方浮现并淡入
  const mainContentOpacity = useTransform(scrollYProgress, [0.75, 0.95], [0, 1]);
  const mainContentY = useTransform(scrollYProgress, [0.75, 1], [100, 0]);
  const mainContentScale = useTransform(scrollYProgress, [0.75, 1], [0.95, 1]);

  // 辅助提示向下滚动的箭头淡出
  const hintOpacity = useTransform(scrollYProgress, [0, 0.1], [1, 0]);

  return (
    <>
      {/* 滚动轨道容器，高度 300vh 留出充足的滑动空间 */}
      <div ref={containerRef} className="relative h-[300vh] w-full z-50">

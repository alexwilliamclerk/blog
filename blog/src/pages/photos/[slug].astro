---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  const sorted = photos.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return sorted.map((photo, index) => ({
    params: { slug: photo.slug },
    props: { 
      photo,
      prev: index > 0 ? sorted[index - 1] : null,
      next: index < sorted.length - 1 ? sorted[index + 1] : null
    },
  }));
}

const { photo, prev, next } = Astro.props;
const { Content } = await photo.render();
const { title, date, location = "未知地点", camera, lens, settings = {}, photos = [] } = photo.data;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 摄影</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@700&display=swap" rel="stylesheet">
    <style>
      :root { --bg: #f9f9f9; --card-bg: #ffffff; --text-main: #1a1a1a; --text-sub: #888888; --accent: #10b981; --border: #eeeeee; --radius: 20px; --shadow: 0 4px 30px rgba(0, 0, 0, 0.05); }
      body { background: var(--bg); color: var(--text-main); font-family: -apple-system, system-ui, sans-serif; padding: 20px; margin: 0; }
      .container { max-width: 800px; margin: 0 auto; padding-top: 40px; padding-bottom: 80px; }
      .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-bottom: 30px; font-weight: 700; }
      .breadcrumb a { text-decoration: none; color: var(--text-main); }
      .breadcrumb .slash { opacity: 0.2; }
      header { margin-bottom: 40px; }
      .title { font-family: 'Noto Serif SC', serif; font-size: 2.5rem; margin-bottom: 10px; }
      .meta-info { color: var(--text-sub); font-size: 14px; display: flex; gap: 15px; }
      .exif-container { background: #f4f4f5; padding: 25px; border-radius: var(--radius); margin-bottom: 40px; }
      .exif-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .exif-item { background: #fff; padding: 14px 18px; border-radius: 14px; display: flex; justify-content: space-between; font-size: 13px; }
      .exif-label { color: #999; }
      .exif-value { font-weight: 600; color: #444; }
      .photo-gallery { display: flex; flex-direction: column; gap: 24px; margin-bottom: 40px; }
      .photo-gallery img { width: 100%; border-radius: 16px; box-shadow: var(--shadow); }
      .notes { background: var(--card-bg); padding: 35px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow); }
      
      .pagination { display: flex; justify-content: space-between; align-items: center; margin-top: 60px; gap: 15px; }
      .nav-link { flex: 1; padding: 15px; background: #fff; border: 1px solid var(--border); border-radius: 16px; text-decoration: none; color: var(--text-main); transition: 0.3s; display: flex; flex-direction: column; min-width: 0; }
      .nav-link:hover { border-color: var(--accent); transform: translateY(-2px); }
      .nav-label { font-size: 11px; color: var(--text-sub); margin-bottom: 4px; }
      .nav-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .back-center { padding: 10px 20px; background: #eee; border-radius: 30px; color: #666; text-decoration: none; font-size: 13px; }
      .empty-space { flex: 1; }
      .text-right { text-align: right; }
      @media (max-width: 600px) { .exif-grid { grid-template-columns: 1fr; } .pagination { flex-direction: column; } .back-center { order: 3; width: 100%; text-align: center; } }
    </style>
  </head>
  <body>
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Alex</a> <span class="slash">/</span> <a href="/photos">摄影</a> <span class="slash">/</span> <span style="color:var(--text-sub)">正文</span>
      </nav>
      <header>
        <h1 class="title">{title}</h1>
        <div class="meta-info"><span>{new Date(date).toLocaleDateString('zh-CN')}</span><span>•</span><span>{location}</span></div>
      </header>
      <div class="exif-container">
        <div class="exif-grid">
          <div class="exif-item"><span class="exif-label">相机</span><span class="exif-value">{camera || '--'}</span></div>
          <div class="exif-item"><span class="exif-label">镜头</span><span class="exif-value">{lens || '--'}</span></div>
          <div class="exif-item"><span class="exif-label">焦距</span><span class="exif-value">{settings.focal || '--'}</span></div>
          <div class="exif-item"><span class="exif-label">光圈</span><span class="exif-value">{settings.aperture || '--'}</span></div>
        </div>
      </div>
      <section class="photo-gallery">{photos.map((img: string) => <img src={img} alt={title} />)}</section>
      <article class="notes"><Content /></article>

      <div class="pagination">
        {prev ? (
          <a href={`/photos/${prev.slug}`} class="nav-link">
            <span class="nav-label">← 上一组</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <div class="empty-space"></div>}
        <a href="/photos" class="back-center">回列表</a>
        {next ? (
          <a href={`/photos/${next.slug}`} class="nav-link text-right">
            <span class="nav-label">下一组 →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        ) : <div class="empty-space"></div>}
      </div>
    </div>
  </body>
</html>
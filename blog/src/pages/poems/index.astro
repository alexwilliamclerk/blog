---
import { getCollection } from "astro:content";

// 保留原有逻辑：过滤草稿、按时间倒序、提取系列
const poemsAll = await getCollection("poems");
const poems = poemsAll
  .filter((p) => !p.data?.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allSeries = [...new Set(poems.map((p) => p.data.series).filter(Boolean))];
const pageTitle = "诗歌";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle} · Alex</title>
    <meta name="description" content="Alex 的诗歌列表，按时间倒序展示。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        color-scheme: light dark;

        --bg-base: #f4f6f7;
        --bg-elevated: rgba(255, 255, 255, 0.76);
        --bg-elevated-strong: rgba(255, 255, 255, 0.88);

        --ambient-1: #afede3;
        --ambient-2: #e8f5ff;
        --ambient-3: #f4edff;
        --ambient-4: #dff3ef;

        --text-main: #1c1c1f;
        --text-sub: #6f737b;
        --text-muted: #9ca2aa;

        --accent: #79ddc9;
        --accent-strong: #56cbb1;

        --border-soft: rgba(255, 255, 255, 0.62);
        --border-strong: rgba(255, 255, 255, 0.94);
        --border-faint: rgba(20, 24, 31, 0.06);

        --shadow-xs: 0 2px 10px rgba(17, 24, 39, 0.04);
        --shadow-sm: 0 8px 24px rgba(17, 24, 39, 0.06);
        --shadow-md: 0 18px 48px rgba(17, 24, 39, 0.09);
        --shadow-lg: 0 32px 80px rgba(17, 24, 39, 0.12);

        --radius-md: 24px;
        --radius-lg: 34px;
        --radius-xl: 42px;
        --radius-pill: 999px;

        --ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-base: #06070a;
          --bg-elevated: rgba(19, 23, 30, 0.58);
          --bg-elevated-strong: rgba(22, 27, 34, 0.78);

          --ambient-1: #0b5b4d;
          --ambient-2: #1a3758;
          --ambient-3: #33224a;
          --ambient-4: #123d3d;

          --text-main: #f4f5f7;
          --text-sub: #b3b8c1;
          --text-muted: #7e8590;

          --accent: #82e5d1;
          --accent-strong: #5ed6bc;

          --border-soft: rgba(255, 255, 255, 0.1);
          --border-strong: rgba(255, 255, 255, 0.18);
          --border-faint: rgba(255, 255, 255, 0.08);

          --shadow-xs: 0 2px 10px rgba(0, 0, 0, 0.28);
          --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.38);
          --shadow-md: 0 20px 52px rgba(0, 0, 0, 0.45);
          --shadow-lg: 0 36px 88px rgba(0, 0, 0, 0.58);
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 16%, rgba(175, 237, 227, 0.42), transparent 30%),
          radial-gradient(circle at 82% 22%, rgba(188, 220, 255, 0.32), transparent 26%),
          radial-gradient(circle at 56% 84%, rgba(227, 217, 255, 0.22), transparent 28%),
          linear-gradient(180deg, var(--bg-base) 0%, color-mix(in srgb, var(--bg-base) 92%, white 8%) 100%);
        color: var(--text-main);
        font-family:
          -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        overflow: hidden;
      }

      .ambient-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.68;
        animation: floatBlob 18s ease-in-out infinite alternate;
      }

      .blob-1 {
        width: 52vw;
        height: 52vw;
        left: -14vw;
        top: -12vh;
        background: radial-gradient(circle, var(--ambient-1) 0%, transparent 70%);
      }

      .blob-2 {
        width: 48vw;
        height: 48vw;
        right: -12vw;
        top: 8vh;
        background: radial-gradient(circle, var(--ambient-2) 0%, transparent 72%);
        animation-delay: -4s;
      }

      .blob-3 {
        width: 42vw;
        height: 42vw;
        left: 24vw;
        bottom: -18vh;
        background: radial-gradient(circle, var(--ambient-3) 0%, transparent 72%);
        animation-delay: -8s;
      }

      .blob-4 {
        width: 36vw;
        height: 36vw;
        right: 18vw;
        bottom: -8vh;
        background: radial-gradient(circle, var(--ambient-4) 0%, transparent 72%);
        animation-delay: -12s;
      }

      @keyframes floatBlob {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(3%, 4%, 0) scale(1.04); }
        100% { transform: translate3d(-4%, 6%, 0) scale(0.96); }
      }

      .page {
        width: 100%;
        max-width: 920px;
        margin: 0 auto;
        padding: 24px 20px 96px;
      }

      .site-header {
        position: sticky;
        top: 16px;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        padding: 12px 16px 12px 18px;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-xs);
        backdrop-filter: blur(22px) saturate(180%);
        -webkit-backdrop-filter: blur(22px) saturate(180%);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 14px;
        font-weight: 800;
        color: white;
        background:
          linear-gradient(180deg, rgba(15, 18, 26, 0.92), rgba(25, 30, 40, 0.9));
        box-shadow:
          inset 0 0 0 2px rgba(255, 255, 255, 0.22),
          0 8px 24px rgba(17, 24, 39, 0.14);
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.15;
      }

      .brand-sub {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.15;
      }

      .nav-links {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
      }

      .nav-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        border-radius: var(--radius-pill);
        color: var(--text-sub);
        font-size: 14px;
        font-weight: 600;
        transition:
          color 0.28s var(--ease-soft),
          background 0.28s var(--ease-soft),
          transform 0.28s var(--ease-soft);
      }

      .nav-item:hover,
      .nav-item:focus-visible {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.34);
        transform: translateY(-1px);
        outline: none;
      }

      .hero-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.28)),
          color-mix(in srgb, var(--bg-elevated) 92%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(26px) saturate(180%);
        -webkit-backdrop-filter: blur(26px) saturate(180%);
        padding: 34px;
        margin-bottom: 18px;
      }

      .hero-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(140deg, rgba(255, 255, 255, 0.42) 0%, transparent 30%),
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.24), transparent 30%);
        pointer-events: none;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-strong);
        box-shadow: 0 0 14px rgba(86, 203, 177, 0.66);
      }

      .hero-title {
        font-family: "Noto Serif SC", serif;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        line-height: 1.05;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 10px;
      }

      .hero-text {
        font-size: 15px;
        color: var(--text-sub);
      }

      .series-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding: 18px 20px;
        margin-bottom: 18px;
        border-radius: 28px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0.14)),
          color-mix(in srgb, var(--bg-elevated) 88%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
      }

      .series-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .series-tag {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 5px 12px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 700;
        color: var(--text-sub);
        background: rgba(255, 255, 255, 0.46);
        border: 1px solid rgba(255, 255, 255, 0.34);
      }

      .poem-list {
        display: grid;
        gap: 16px;
      }

      .poem-card {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 18px;
        align-items: center;
        padding: 24px 26px;
        border-radius: 30px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.18)),
          color-mix(in srgb, var(--bg-elevated) 90%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        transition:
          transform 0.34s var(--ease-soft),
          box-shadow 0.34s var(--ease-soft),
          border-color 0.34s var(--ease-soft),
          background 0.34s var(--ease-soft);
      }

      .poem-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent 30%),
          radial-gradient(circle at top right, rgba(175, 237, 227, 0.16), transparent 26%);
        pointer-events: none;
      }

      .poem-card:hover,
      .poem-card:focus-visible {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
        border-color: var(--border-strong);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.2)),
          color-mix(in srgb, var(--bg-elevated-strong) 92%, transparent);
        outline: none;
      }

      .poem-info {
        position: relative;
        z-index: 1;
        min-width: 0;
      }

      .poem-type {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-strong);
      }

      .poem-type-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent-strong);
      }

      .poem-name {
        font-family: "Noto Serif SC", serif;
        font-size: clamp(1.15rem, 3vw, 1.45rem);
        line-height: 1.3;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 8px;
        word-break: break-word;
      }

      .poem-desc {
        font-size: 14px;
        color: var(--text-sub);
      }

      .poem-meta {
        position: relative;
        z-index: 1;
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
      }

      .date {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sub);
        white-space: nowrap;
      }

      .series-name {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 700;
        color: var(--accent-strong);
        background: rgba(86, 203, 177, 0.1);
        border: 1px solid rgba(86, 203, 177, 0.14);
      }

      .site-footer {
        margin-top: 42px;
        padding: 22px 6px 0;
        border-top: 1px solid var(--border-faint);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-copy {
        font-size: 13px;
        color: var(--text-muted);
      }

      .footer-links {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .footer-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sub);
      }

      .footer-link:hover,
      .footer-link:focus-visible {
        color: var(--text-main);
        outline: none;
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(10px);
        animation: revealUp 0.72s var(--ease-soft) forwards;
      }

      .delay-1 { animation-delay: 0.06s; }
      .delay-2 { animation-delay: 0.14s; }

      @keyframes revealUp {
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 700px) {
        .page {
          padding: 16px 16px 72px;
        }

        .site-header {
          top: 10px;
          flex-wrap: wrap;
          gap: 14px;
          padding: 10px 12px 10px 14px;
        }

        .brand-sub {
          display: none;
        }

        .nav-links {
          width: 100%;
          justify-content: flex-end;
        }

        .hero-card {
          padding: 24px 18px;
        }

        .poem-card {
          grid-template-columns: 1fr;
          align-items: flex-start;
          padding: 20px 20px 18px;
        }

        .poem-meta {
          align-items: flex-start;
          text-align: left;
        }

        .site-footer {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-1"></div>
      <div class="ambient-blob blob-2"></div>
      <div class="ambient-blob blob-3"></div>
      <div class="ambient-blob blob-4"></div>
    </div>

    <div class="page">
      <header class="site-header reveal">
        <a href="/" class="brand" aria-label="返回首页">
          <div class="brand-mark">A</div>
          <div class="brand-text">
            <span class="brand-name">Alex</span>
            <span class="brand-sub">Poems</span>
          </div>
        </a>

        <nav class="nav-links" aria-label="页面导航">
          <a class="nav-item" href="/">首页</a>
          <a class="nav-item" href="/photos/">摄影</a>
          <a class="nav-item" href="/search/">搜索</a>
        </nav>
      </header>

      <main>
        <section class="hero-card reveal delay-1">
          <span class="eyebrow">Poems</span>
          <h1 class="hero-title">{pageTitle}</h1>
          <p class="hero-text">共 {poems.length} 首公开内容 · 按时间倒序</p>
        </section>

        {allSeries.length > 0 && (
          <div class="series-bar reveal delay-1">
            <span class="series-label">系列</span>
            {allSeries.map((s) => (
              <span class="series-tag">#{s}</span>
            ))}
          </div>
        )}

        <section class="poem-list">
          {poems.map((poem, index) => (
            <a
              href={`/poems/${poem.slug}`}
              class="poem-card reveal delay-2"
              style={`animation-delay:${0.12 + index * 0.05}s;`}
            >
              <div class="poem-info">
                <div class="poem-type">
                  <span class="poem-type-dot"></span>
                  <span>诗歌</span>
                </div>

                <div class="poem-name">{poem.data.title}</div>
                <div class="poem-desc">
                  {poem.data.description || "点击阅读全文..."}
                </div>
              </div>

              <div class="poem-meta">
                <span class="date">
                  {new Date(poem.data.date).toLocaleDateString("zh-CN")}
                </span>
                {poem.data.series && (
                  <span class="series-name"># {poem.data.series}</span>
                )}
              </div>
            </a>
          ))}
        </section>
      </main>

      <footer class="site-footer reveal delay-2">
        <p class="footer-copy">Alex · Poems</p>

        <div class="footer-links">
          <a href="/" class="footer-link">首页</a>
          <a href="/photos/" class="footer-link">摄影</a>
          <a href="/search/" class="footer-link">搜索</a>
        </div>
      </footer>
    </div>
  </body>
</html>
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>摄影 · Alex</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #f9f9f9;
        --card-bg: #ffffff;
        --text-main: #1a1a1a;
        --text-sub: #888888;
        --accent: #10b981;
        --border: #eeeeee;
        --radius: 24px;
        --shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
      }

      * { box-sizing: border-box; }

      body {
        background: var(--bg);
        color: var(--text-main);
        font-family: -apple-system, system-ui, sans-serif;
        line-height: 1.6;
        padding: 20px;
        margin: 0;
      }

      .container { 
        max-width: 800px; 
        margin: 0 auto; 
        padding-top: 60px; 
        padding-bottom: 80px; 
      }

      /* 导航 */
      .nav { 
        display: flex; 
        gap: 8px; 
        margin-bottom: 40px; 
        font-weight: 700; 
        align-items: center; 
      }
      .nav a { color: var(--text-main); text-decoration: none; font-size: 14px; }
      .nav .slash { opacity: 0.2; }

      header { margin-bottom: 40px; }
      h1 { 
        font-family: 'Noto Serif SC', serif; 
        font-size: 2.8rem; 
        margin: 0 0 10px 0; 
      }
      .count { color: var(--text-sub); font-size: 14px; }

      /* 列表布局 */
      .photo-list { 
        display: flex; 
        flex-direction: column; 
        gap: 20px; 
      }

      .photo-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 30px;
        text-decoration: none;
        color: inherit;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow);
      }

      .photo-card:hover {
        border-color: var(--accent);
        transform: translateX(8px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.06);
      }

      .info { display: flex; flex-direction: column; gap: 6px; }
      .title { 
        font-size: 1.25rem; 
        font-weight: 700; 
        color: #333; 
      }
      .meta { 
        font-size: 13px; 
        color: var(--text-sub); 
        display: flex; 
        gap: 10px; 
      }

      .tags { display: flex; gap: 8px; margin-top: 8px; }
      .tag { 
        font-size: 11px; 
        background: rgba(16, 185, 129, 0.08); 
        color: var(--accent); 
        padding: 2px 8px; 
        border-radius: 6px; 
        font-weight: 700;
      }

      .arrow { 
        font-size: 1.5rem; 
        color: var(--accent); 
        opacity: 0; 
        transform: translateX(-10px); 
        transition: 0.3s; 
      }
      .photo-card:hover .arrow { opacity: 1; transform: translateX(0); }

      @media (max-width: 600px) {
        h1 { font-size: 2rem; }
        .photo-card { padding: 20px; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <nav class="nav">
        <a href="/">首页</a>
        <span class="slash">/</span>
        <span style="color:var(--text-sub); font-weight:normal;">摄影</span>
      </nav>

      <header>
        <h1>摄影</h1>
        <p class="count">共 {sortedPhotos.length} 组记录 · 按时间倒序</p>
      </header>

      <div class="photo-list">
        {sortedPhotos.map((photo) => (
          <a href={`/photos/${photo.slug}`} class="photo-card">
            <div class="info">
              <span class="title">{photo.data.title}</span>
              <div class="meta">
                <span>{new Date(photo.data.date).toLocaleDateString('zh-CN')}</span>
                <span>•</span>
                <span>{photo.data.location}</span>
              </div>
              <div class="tags">
                {photo.data.tags?.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>
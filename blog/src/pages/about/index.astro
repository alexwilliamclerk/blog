---
const site = {
  name: "Alex",
  tagline: "写诗 / 摄影 / 记录",
  intro: [
    "这里是我的个人博客，主要放诗歌与摄影。",
    "我喜欢把日常切成小片段：一段风、一束光、一次路过的心情。",
    "网站是静态的，慢慢更新，不追热点。"
  ],
  now: [
    "正在持续整理诗歌与摄影的「系列」",
    "把站点打磨得更像一个能长期住下来的空间"
  ],
  contact: [
    { label: "GitHub", value: "alexwilliamclerk", href: "https://github.com/alexwilliamclerk" },
    // { label: "Email", value: "you@example.com", href: "mailto:you@example.com" },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>关于 - {site.name}</title>
    <meta name="description" content="关于我：写诗、摄影、记录。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        color-scheme: light dark;

        --bg-base: #f4f6f7;
        --bg-elevated: rgba(255, 255, 255, 0.76);
        --bg-elevated-strong: rgba(255, 255, 255, 0.88);

        --ambient-1: #afede3;
        --ambient-2: #e8f5ff;
        --ambient-3: #f4edff;
        --ambient-4: #dff3ef;

        --text-main: #1c1c1f;
        --text-sub: #6f737b;
        --text-muted: #9ca2aa;

        --accent: #79ddc9;
        --accent-strong: #56cbb1;

        --border-soft: rgba(255, 255, 255, 0.62);
        --border-strong: rgba(255, 255, 255, 0.94);
        --border-faint: rgba(20, 24, 31, 0.06);

        --shadow-xs: 0 2px 10px rgba(17, 24, 39, 0.04);
        --shadow-sm: 0 8px 24px rgba(17, 24, 39, 0.06);
        --shadow-md: 0 18px 48px rgba(17, 24, 39, 0.09);
        --shadow-lg: 0 32px 80px rgba(17, 24, 39, 0.12);

        --radius-sm: 16px;
        --radius-md: 24px;
        --radius-lg: 34px;
        --radius-xl: 42px;
        --radius-pill: 999px;

        --ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-base: #06070a;
          --bg-elevated: rgba(19, 23, 30, 0.58);
          --bg-elevated-strong: rgba(22, 27, 34, 0.78);

          --ambient-1: #0b5b4d;
          --ambient-2: #1a3758;
          --ambient-3: #33224a;
          --ambient-4: #123d3d;

          --text-main: #f4f5f7;
          --text-sub: #b3b8c1;
          --text-muted: #7e8590;

          --accent: #82e5d1;
          --accent-strong: #5ed6bc;

          --border-soft: rgba(255, 255, 255, 0.1);
          --border-strong: rgba(255, 255, 255, 0.18);
          --border-faint: rgba(255, 255, 255, 0.08);

          --shadow-xs: 0 2px 10px rgba(0, 0, 0, 0.28);
          --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.38);
          --shadow-md: 0 20px 52px rgba(0, 0, 0, 0.45);
          --shadow-lg: 0 36px 88px rgba(0, 0, 0, 0.58);
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 16%, rgba(175, 237, 227, 0.42), transparent 30%),
          radial-gradient(circle at 82% 22%, rgba(188, 220, 255, 0.32), transparent 26%),
          radial-gradient(circle at 56% 84%, rgba(227, 217, 255, 0.22), transparent 28%),
          linear-gradient(180deg, var(--bg-base) 0%, color-mix(in srgb, var(--bg-base) 92%, white 8%) 100%);
        color: var(--text-main);
        font-family:
          -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        overflow: hidden;
      }

      .ambient-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.68;
        animation: floatBlob 18s ease-in-out infinite alternate;
      }

      .blob-1 {
        width: 52vw;
        height: 52vw;
        left: -14vw;
        top: -12vh;
        background: radial-gradient(circle, var(--ambient-1) 0%, transparent 70%);
      }

      .blob-2 {
        width: 48vw;
        height: 48vw;
        right: -12vw;
        top: 8vh;
        background: radial-gradient(circle, var(--ambient-2) 0%, transparent 72%);
        animation-delay: -4s;
      }

      .blob-3 {
        width: 42vw;
        height: 42vw;
        left: 24vw;
        bottom: -18vh;
        background: radial-gradient(circle, var(--ambient-3) 0%, transparent 72%);
        animation-delay: -8s;
      }

      .blob-4 {
        width: 36vw;
        height: 36vw;
        right: 18vw;
        bottom: -8vh;
        background: radial-gradient(circle, var(--ambient-4) 0%, transparent 72%);
        animation-delay: -12s;
      }

      @keyframes floatBlob {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(3%, 4%, 0) scale(1.04); }
        100% { transform: translate3d(-4%, 6%, 0) scale(0.96); }
      }

      .page {
        width: 100%;
        max-width: 920px;
        margin: 0 auto;
        padding: 24px 20px 96px;
      }

      .site-header {
        position: sticky;
        top: 16px;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        padding: 12px 16px 12px 18px;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-xs);
        backdrop-filter: blur(22px) saturate(180%);
        -webkit-backdrop-filter: blur(22px) saturate(180%);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 14px;
        font-weight: 800;
        color: #fff;
        background:
          linear-gradient(180deg, rgba(15, 18, 26, 0.92), rgba(25, 30, 40, 0.9));
        box-shadow:
          inset 0 0 0 2px rgba(255, 255, 255, 0.22),
          0 8px 24px rgba(17, 24, 39, 0.14);
      }

      .brand-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .brand-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.15;
      }

      .brand-sub {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.15;
      }

      .nav-links {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
      }

      .nav-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        border-radius: var(--radius-pill);
        color: var(--text-sub);
        font-size: 14px;
        font-weight: 600;
        transition:
          color 0.28s var(--ease-soft),
          background 0.28s var(--ease-soft),
          transform 0.28s var(--ease-soft);
      }

      .nav-item:hover,
      .nav-item:focus-visible {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.34);
        transform: translateY(-1px);
        outline: none;
      }

      .hero-card,
      .glass-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.28)),
          color-mix(in srgb, var(--bg-elevated) 92%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(26px) saturate(180%);
        -webkit-backdrop-filter: blur(26px) saturate(180%);
      }

      .hero-card::before,
      .glass-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(140deg, rgba(255, 255, 255, 0.42) 0%, transparent 30%),
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.24), transparent 30%);
        pointer-events: none;
      }

      .hero-card {
        padding: 34px;
        margin-bottom: 22px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-strong);
        box-shadow: 0 0 14px rgba(86, 203, 177, 0.66);
      }

      .hero-title {
        font-family: "Noto Serif SC", serif;
        font-size: clamp(2.5rem, 6vw, 4rem);
        line-height: 1.02;
        margin-bottom: 12px;
        color: var(--text-main);
      }

      .hero-tagline {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.04rem;
        color: var(--text-sub);
        font-weight: 600;
      }

      .status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--accent-strong);
        box-shadow: 0 0 18px rgba(86, 203, 177, 0.8);
      }

      .content-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 18px;
        margin-top: 20px;
      }

      .glass-card {
        padding: 24px;
      }

      .section-kicker {
        display: inline-block;
        margin-bottom: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .section-title {
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 14px;
        color: var(--text-main);
      }

      .intro-list {
        display: grid;
        gap: 14px;
      }

      .intro-text {
        font-size: 15px;
        color: var(--text-sub);
      }

      .now-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .now-tag {
        display: inline-flex;
        align-items: center;
        min-height: 38px;
        padding: 8px 14px;
        border-radius: var(--radius-pill);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.46), rgba(255, 255, 255, 0.16));
        border: 1px solid rgba(255, 255, 255, 0.34);
        box-shadow: var(--shadow-xs);
        font-size: 13px;
        color: var(--text-sub);
      }

      .contact-list {
        display: grid;
        gap: 12px;
      }

      .contact-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.14));
        border: 1px solid rgba(255, 255, 255, 0.32);
        transition:
          transform 0.28s var(--ease-soft),
          box-shadow 0.28s var(--ease-soft),
          background 0.28s var(--ease-soft);
      }

      .contact-card:hover,
      .contact-card:focus-visible {
        transform: translateY(-2px);
        box-shadow: var(--shadow-sm);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.18));
        outline: none;
      }

      .contact-icon {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 12px;
        font-weight: 700;
        color: var(--text-sub);
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.4);
      }

      .contact-meta {
        min-width: 0;
      }

      .contact-label {
        font-size: 12px;
        color: var(--text-muted);
        margin-bottom: 2px;
      }

      .contact-value {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-main);
        word-break: break-all;
      }

      .site-footer {
        margin-top: 42px;
        padding: 22px 6px 0;
        border-top: 1px solid var(--border-faint);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-copy {
        font-size: 13px;
        color: var(--text-muted);
      }

      .footer-links {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .footer-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sub);
      }

      .footer-link:hover,
      .footer-link:focus-visible {
        color: var(--text-main);
        outline: none;
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(10px);
        animation: revealUp 0.72s var(--ease-soft) forwards;
      }

      .delay-1 { animation-delay: 0.06s; }
      .delay-2 { animation-delay: 0.14s; }
      .delay-3 { animation-delay: 0.22s; }

      @keyframes revealUp {
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 760px) {
        .page {
          padding: 16px 16px 72px;
        }

        .site-header {
          gap: 14px;
          padding: 10px 12px 10px 14px;
        }

        .brand-sub {
          display: none;
        }

        .content-grid {
          grid-template-columns: 1fr;
        }

        .hero-card,
        .glass-card {
          padding: 22px 18px;
        }
      }

      @media (max-width: 540px) {
        .site-header {
          top: 10px;
          flex-wrap: wrap;
        }

        .nav-links {
          width: 100%;
          justify-content: flex-end;
        }

        .site-footer {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-1"></div>
      <div class="ambient-blob blob-2"></div>
      <div class="ambient-blob blob-3"></div>
      <div class="ambient-blob blob-4"></div>
    </div>

    <div class="page">
      <header class="site-header reveal">
        <a href="/" class="brand" aria-label="返回首页">
          <div class="brand-mark">{site.name[0]}</div>
          <div class="brand-text">
            <span class="brand-name">{site.name}</span>
            <span class="brand-sub">About</span>
          </div>
        </a>

        <nav class="nav-links" aria-label="页面导航">
          <a class="nav-item" href="/">首页</a>
          <a class="nav-item" href="/links/">友链</a>
          <a class="nav-item" href="/search/">搜索</a>
        </nav>
      </header>

      <main>
        <section class="hero-card reveal delay-1">
          <span class="eyebrow">About</span>
          <h1 class="hero-title">{site.name}</h1>
          <div class="hero-tagline">
            <span class="status-dot" aria-hidden="true"></span>
            <span>{site.tagline}</span>
          </div>
        </section>

        <section class="content-grid">
          <article class="glass-card reveal delay-2">
            <span class="section-kicker">Intro</span>
            <h2 class="section-title">关于这里</h2>
            <div class="intro-list">
              {site.intro.map((text) => (
                <p class="intro-text">{text}</p>
              ))}
            </div>
          </article>

          <article class="glass-card reveal delay-2">
            <span class="section-kicker">Now</span>
            <h2 class="section-title">最近</h2>
            <div class="now-list">
              {site.now.map((item) => (
                <span class="now-tag">{item}</span>
              ))}
            </div>
          </article>
        </section>

        <section class="glass-card reveal delay-3" style="margin-top: 18px;">
          <span class="section-kicker">Contact</span>
          <h2 class="section-title">联系 / 账号</h2>
          <div class="contact-list">
            {site.contact.map((c) => (
              <a class="contact-card" href={c.href} target="_blank" rel="noreferrer">
                <div class="contact-icon">↗</div>
                <div class="contact-meta">
                  <div class="contact-label">{c.label}</div>
                  <div class="contact-value">{c.value}</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      </main>

      <footer class="site-footer reveal delay-3">
        <p class="footer-copy">
          © {new Date().getFullYear()} {site.name}
        </p>

        <div class="footer-links">
          <a href="/" class="footer-link">首页</a>
          <a href="/links/" class="footer-link">友链</a>
          <a href="/search/" class="footer-link">搜索</a>
        </div>
      </footer>
    </div>
  </body>
</html>
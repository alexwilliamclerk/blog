// 顶级玻璃拟态卡片，带鼠标感应流光边界
const PremiumGlowCard: React.FC<{ children: React.ReactNode; className?: string; delay?: number }> = ({ children, className, delay = 0 }) => {
  const mousePosition = useMousePosition();
  const cardRef = useRef<HTMLDivElement>(null);
  const [box, setBox] = useState({ left: 0, top: 0 });

  useEffect(() => {
    if (cardRef.current) {
      const rect = cardRef.current.getBoundingClientRect();
      setBox({ left: rect.left, top: rect.top });
    }
  }, [mousePosition]);

  const x = mousePosition.x - box.left;
  const y = mousePosition.y - box.top;

  return (
    <motion.div
      ref={cardRef}
      initial={{ opacity: 0, y: 30 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.8, delay, ease: THEME.animation.easeOutExpo }}
      className={cn(
        "relative overflow-hidden rounded-2xl border border-white/5 bg-white/[0.02] backdrop-blur-3xl",
        "transition-all duration-500 hover:bg-white/[0.04] hover:shadow-[0_8px_32px_rgba(0,0,0,0.4)] hover:border-white/10",
        className
      )}
    >
      {/* 鼠标悬浮探照灯效果 */}
      <div 
        className="pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        style={{
          background: `radial-gradient(500px circle at ${x}px ${y}px, rgba(175, 237, 227, 0.08), transparent 40%)`
        }}
      />
      <div className="relative z-10 h-full">{children}</div>
    </motion.div>
  );
};


---
import { getCollection } from "astro:content";

// 1. 获取内容数据
const poemsAll = await getCollection("poems");
const photosAll = await getCollection("photos");

// 过滤掉草稿
const poems = poemsAll.filter((p) => !p.data?.draft);
const photos = photosAll.filter((p) => !p.data?.draft);

// 统计逻辑
const seriesSet = new Set();
poems.forEach(p => p.data?.series && seriesSet.add(p.data.series));
photos.forEach(p => p.data?.series && seriesSet.add(p.data.series));

const profile = {
  name: "Alex",
  tagline: "写诗 / 摄影 / 记录",
  stats: [
    { label: "诗歌", count: poems.length },
    { label: "摄影", count: photos.length },
    { label: "系列", count: seriesSet.size }
  ]
};

// 合并最新的内容用于首页展示
const latestContent = [
  ...poems.map(p => ({ ...p, type: 'poems', typeLabel: '诗歌' })),
  ...photos.map(p => ({ ...p, type: 'photos', typeLabel: '摄影' }))
].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 6);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · 首页</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #f9f9f9;          /* 浅灰色背景  */
        --card-bg: #ffffff;      /* 纯白卡片  */
        --text-main: #1a1a1a;    /* 深色主文字  */
        --text-sub: #666666;     /* 灰色副文字  */
        --accent: #10b981;       /* 绿色点缀 [cite: 81] */
        --border: #eeeeee;       /* 边框色  */
        --radius: 20px;          /* 圆角 [cite: 61] */
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.04); /* 柔和阴影 [cite: 60] */
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--bg);
        color: var(--text-main);
        font-family: -apple-system, system-ui, sans-serif;
        line-height: 1.6;
        padding: 20px;
      }

      .container { max-width: 700px; margin: 0 auto; padding-top: 40px; }

      /* 顶部导航 [cite: 67] */
      header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
      .logo { display: flex; align-items: center; gap: 8px; font-weight: 700; }
      .avatar-sm { width: 30px; height: 30px; background: #333; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; }
      .nav-links { display: flex; gap: 15px; }
      .nav-item { text-decoration: none; color: var(--text-sub); font-size: 14px; }

      /* 主卡片 [cite: 74, 75] */
      .main-card {
        background: var(--card-bg);
        border-radius: var(--radius);
        padding: 35px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        margin-bottom: 25px;
      }
      .title { font-family: 'Noto Serif SC', serif; font-size: 2.2rem; margin-bottom: 5px; }
      .tagline { color: var(--text-sub); margin-bottom: 25px; }

      /* 修正后的横向统计样式 [cite: 79, 83] */
      .stats-row {
        background: #f4f4f5; /* 浅灰底盒 [cite: 79] */
        padding: 15px 20px;
        border-radius: 14px;
        display: flex;
        gap: 20px;
        align-items: center;
      }
      .status-dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.1); }
      .stat-item { 
        font-size: 14px; 
        color: #555; 
        display: flex; 
        align-items: center; 
        gap: 5px; 
      }
      .stat-item b { color: var(--text-main); font-weight: 700; }

      /* 分类标签页 */
      .tabs { display: flex; gap: 10px; margin: 35px 0 20px; }
      .tab {
        padding: 7px 18px; border-radius: 20px; background: #eee; color: #777;
        text-decoration: none; font-size: 13px; font-weight: 600;
      }
      .tab.active { background: var(--accent); color: white; }

      /* 文章列表 [cite: 86] */
      .post-list { display: flex; flex-direction: column; gap: 15px; }
      .post-card {
        background: var(--card-bg);
        padding: 20px 25px;
        border-radius: 16px;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: 0.2s;
      }
      .post-card:hover { border-color: var(--accent); transform: translateX(5px); box-shadow: var(--shadow); }
      .post-info .type { font-size: 11px; color: var(--accent); font-weight: 700; margin-bottom: 4px; display: block; }
      .post-info .post-title { font-size: 1.1rem; font-weight: 600; }
      .post-meta { text-align: right; color: #999; font-size: 12px; }

      @media (max-width: 500px) {
        .stats-row { flex-wrap: wrap; gap: 10px; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="logo">
          <div class="avatar-sm">A</div>
          <span>{profile.name} <span style="font-weight:normal; opacity:0.3; margin:0 4px;">/</span> 首页</span>
        </div>
        <nav class="nav-links">
          <a href="/about" class="nav-item">关于</a>
          <a href="/links" class="nav-item">友链</a>
          <a href="/search" class="nav-item">搜索</a>
        </nav>
      </header>

      <main>
        <section class="main-card">
          <h1 class="title">{profile.name}</h1>
          <p class="tagline">{profile.tagline}</p>
          
          <div class="stats-row">
            <span class="status-dot"></span>
            <span style="font-size:12px; color:#999; margin-right:10px;">站点统计</span>
            {profile.stats.map(s => (
              <div class="stat-item">{s.label}: <b>{s.count}</b></div>
            ))}
          </div>
        </section>

        <nav class="tabs">
          <a href="/" class="tab active">最近更新</a>
          <a href="/poems" class="tab">诗歌</a>
          <a href="/photos" class="tab">摄影</a>
        </nav>

        <div class="post-list">
          {latestContent.map(item => (
            <a href={`/${item.type}/${item.slug}`} class="post-card">
              <div class="post-info">
                <span class="type">{item.typeLabel}</span>
                <div class="post-title">{item.data.title}</div>
              </div>
              <div class="post-meta">
                <div>{new Date(item.data.date).toLocaleDateString('zh-CN')}</div>
                <div style="color:var(--accent); margin-top:4px;">→</div>
              </div>
            </a>
          ))}
        </div>
      </main>
    </div>
  </body>
</html>
---
const links = [
  { name: "Astro", desc: "静态站点框架", url: "https://astro.build/" },
  { name: "Nginx", desc: "Web 服务器", url: "https://nginx.org/" },
  { name: "Cloudflare", desc: "DNS / CDN / 规则", url: "https://www.cloudflare.com/" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>友链</title>
    <meta name="description" content="Alex 的友链与常用站点。" />

    <style>
      :root {
        color-scheme: light dark;

        --bg-base: #f4f6f7;
        --bg-elevated: rgba(255, 255, 255, 0.76);
        --bg-elevated-strong: rgba(255, 255, 255, 0.88);

        --ambient-1: #afede3;
        --ambient-2: #e8f5ff;
        --ambient-3: #f4edff;
        --ambient-4: #dff3ef;

        --text-main: #1c1c1f;
        --text-sub: #6f737b;
        --text-muted: #9ca2aa;

        --accent: #79ddc9;
        --accent-strong: #56cbb1;

        --border-soft: rgba(255, 255, 255, 0.62);
        --border-strong: rgba(255, 255, 255, 0.94);
        --border-faint: rgba(20, 24, 31, 0.06);

        --shadow-xs: 0 2px 10px rgba(17, 24, 39, 0.04);
        --shadow-sm: 0 8px 24px rgba(17, 24, 39, 0.06);
        --shadow-md: 0 18px 48px rgba(17, 24, 39, 0.09);
        --shadow-lg: 0 32px 80px rgba(17, 24, 39, 0.12);

        --radius-md: 24px;
        --radius-lg: 34px;
        --radius-xl: 42px;
        --radius-pill: 999px;

        --ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-base: #06070a;
          --bg-elevated: rgba(19, 23, 30, 0.58);
          --bg-elevated-strong: rgba(22, 27, 34, 0.78);

          --ambient-1: #0b5b4d;
          --ambient-2: #1a3758;
          --ambient-3: #33224a;
          --ambient-4: #123d3d;

          --text-main: #f4f5f7;
          --text-sub: #b3b8c1;
          --text-muted: #7e8590;

          --accent: #82e5d1;
          --accent-strong: #5ed6bc;

          --border-soft: rgba(255, 255, 255, 0.1);
          --border-strong: rgba(255, 255, 255, 0.18);
          --border-faint: rgba(255, 255, 255, 0.08);

          --shadow-xs: 0 2px 10px rgba(0, 0, 0, 0.28);
          --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.38);
          --shadow-md: 0 20px 52px rgba(0, 0, 0, 0.45);
          --shadow-lg: 0 36px 88px rgba(0, 0, 0, 0.58);
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 16%, rgba(175, 237, 227, 0.42), transparent 30%),
          radial-gradient(circle at 82% 22%, rgba(188, 220, 255, 0.32), transparent 26%),
          radial-gradient(circle at 56% 84%, rgba(227, 217, 255, 0.22), transparent 28%),
          linear-gradient(180deg, var(--bg-base) 0%, color-mix(in srgb, var(--bg-base) 92%, white 8%) 100%);
        color: var(--text-main);
        font-family:
          -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        overflow: hidden;
      }

      .ambient-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.68;
        animation: floatBlob 18s ease-in-out infinite alternate;
      }

      .blob-1 {
        width: 52vw;
        height: 52vw;
        left: -14vw;
        top: -12vh;
        background: radial-gradient(circle, var(--ambient-1) 0%, transparent 70%);
      }

      .blob-2 {
        width: 48vw;
        height: 48vw;
        right: -12vw;
        top: 8vh;
        background: radial-gradient(circle, var(--ambient-2) 0%, transparent 72%);
        animation-delay: -4s;
      }

      .blob-3 {
        width: 42vw;
        height: 42vw;
        left: 24vw;
        bottom: -18vh;
        background: radial-gradient(circle, var(--ambient-3) 0%, transparent 72%);
        animation-delay: -8s;
      }

      .blob-4 {
        width: 36vw;
        height: 36vw;
        right: 18vw;
        bottom: -8vh;
        background: radial-gradient(circle, var(--ambient-4) 0%, transparent 72%);
        animation-delay: -12s;
      }

      @keyframes floatBlob {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(3%, 4%, 0) scale(1.04); }
        100% { transform: translate3d(-4%, 6%, 0) scale(0.96); }
      }

      .page {
        width: 100%;
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px 96px;
      }

      .site-header {
        position: sticky;
        top: 16px;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        padding: 12px 16px 12px 18px;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-xs);
        backdrop-filter: blur(22px) saturate(180%);
        -webkit-backdrop-filter: blur(22px) saturate(180%);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .brand-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-strong);
        box-shadow: 0 0 14px rgba(86, 203, 177, 0.66);
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.15;
      }

      .brand-sub {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.15;
      }

      .nav-links {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
      }

      .nav-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        border-radius: var(--radius-pill);
        color: var(--text-sub);
        font-size: 14px;
        font-weight: 600;
        transition:
          color 0.28s var(--ease-soft),
          background 0.28s var(--ease-soft),
          transform 0.28s var(--ease-soft);
      }

      .nav-item:hover,
      .nav-item:focus-visible {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.34);
        transform: translateY(-1px);
        outline: none;
      }

      .hero-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.28)),
          color-mix(in srgb, var(--bg-elevated) 92%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(26px) saturate(180%);
        -webkit-backdrop-filter: blur(26px) saturate(180%);
        padding: 34px;
        margin-bottom: 20px;
      }

      .hero-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(140deg, rgba(255, 255, 255, 0.42) 0%, transparent 30%),
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.24), transparent 30%);
        pointer-events: none;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-strong);
        box-shadow: 0 0 14px rgba(86, 203, 177, 0.66);
      }

      .hero-title {
        font-size: clamp(2rem, 5vw, 3.2rem);
        line-height: 1.05;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 10px;
      }

      .hero-text {
        max-width: 42ch;
        font-size: 15px;
        color: var(--text-sub);
      }

      .links-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .link-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 190px;
        padding: 22px 22px 20px;
        border-radius: var(--radius-lg);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.18)),
          color-mix(in srgb, var(--bg-elevated) 90%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        transition:
          transform 0.34s var(--ease-soft),
          box-shadow 0.34s var(--ease-soft),
          border-color 0.34s var(--ease-soft),
          background 0.34s var(--ease-soft);
      }

      .link-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent 30%),
          radial-gradient(circle at top right, rgba(175, 237, 227, 0.16), transparent 26%);
        pointer-events: none;
      }

      .link-card:hover,
      .link-card:focus-visible {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
        border-color: var(--border-strong);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.2)),
          color-mix(in srgb, var(--bg-elevated-strong) 92%, transparent);
        outline: none;
      }

      .link-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }

      .link-mark {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background:
          linear-gradient(180deg, rgba(255,255,255,0.46), rgba(255,255,255,0.16));
        border: 1px solid rgba(255,255,255,0.34);
        color: var(--text-sub);
        font-size: 14px;
        font-weight: 800;
        flex: 0 0 42px;
      }

      .link-arrow {
        font-size: 14px;
        color: var(--text-muted);
      }

      .link-body {
        position: relative;
        z-index: 1;
      }

      .link-title {
        font-size: 1.12rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 8px;
      }

      .link-desc {
        font-size: 14px;
        color: var(--text-sub);
        margin-bottom: 12px;
      }

      .link-url {
        font-size: 12px;
        line-height: 1.5;
        color: var(--text-muted);
        word-break: break-all;
      }

      .site-footer {
        margin-top: 42px;
        padding: 22px 6px 0;
        border-top: 1px solid var(--border-faint);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-copy {
        font-size: 13px;
        color: var(--text-muted);
      }

      .footer-links {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .footer-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sub);
      }

      .footer-link:hover,
      .footer-link:focus-visible {
        color: var(--text-main);
        outline: none;
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(10px);
        animation: revealUp 0.72s var(--ease-soft) forwards;
      }

      .delay-1 { animation-delay: 0.06s; }
      .delay-2 { animation-delay: 0.14s; }
      .delay-3 { animation-delay: 0.22s; }

      @keyframes revealUp {
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 820px) {
        .links-grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 640px) {
        .page {
          padding: 16px 16px 72px;
        }

        .site-header {
          top: 10px;
          flex-wrap: wrap;
          gap: 14px;
          padding: 10px 12px 10px 14px;
        }

        .nav-links {
          width: 100%;
          justify-content: flex-end;
        }

        .hero-card {
          padding: 24px 18px;
        }

        .links-grid {
          grid-template-columns: 1fr;
        }

        .site-footer {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-1"></div>
      <div class="ambient-blob blob-2"></div>
      <div class="ambient-blob blob-3"></div>
      <div class="ambient-blob blob-4"></div>
    </div>

    <div class="page">
      <header class="site-header reveal">
        <a href="/" class="brand" aria-label="返回首页">
          <span class="brand-dot"></span>
          <div class="brand-text">
            <span class="brand-name">Alex · 博客</span>
            <span class="brand-sub">Links</span>
          </div>
        </a>

        <nav class="nav-links" aria-label="页面导航">
          <a class="nav-item" href="/">首页</a>
          <a class="nav-item" href="/about/">关于我</a>
          <a class="nav-item" href="/search/">搜索</a>
        </nav>
      </header>

      <main>
        <section class="hero-card reveal delay-1">
          <span class="eyebrow">Links</span>
          <h1 class="hero-title">友链</h1>
          <p class="hero-text">
            一些常用的工具与站点入口，保持简单、直接。
          </p>
        </section>

        <section class="links-grid">
          {links.map((x, index) => (
            <a
              class="link-card reveal delay-2"
              href={x.url}
              target="_blank"
              rel="noreferrer"
              style={`animation-delay:${0.1 + index * 0.06}s;`}
            >
              <div class="link-top">
                <div class="link-mark">{x.name[0]}</div>
                <div class="link-arrow">↗</div>
              </div>

              <div class="link-body">
                <div class="link-title">{x.name}</div>
                <div class="link-desc">{x.desc}</div>
                <div class="link-url">{x.url}</div>
              </div>
            </a>
          ))}
        </section>
      </main>

      <footer class="site-footer reveal delay-3">
        <p class="footer-copy">Alex · Links</p>

        <div class="footer-links">
          <a href="/" class="footer-link">首页</a>
          <a href="/about/" class="footer-link">关于我</a>
          <a href="/search/" class="footer-link">搜索</a>
        </div>
      </footer>
    </div>
  </body>
</html>
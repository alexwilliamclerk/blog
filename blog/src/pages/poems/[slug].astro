---
import { getCollection } from "astro:content";

// 1. 生成所有诗歌的静态路径
export async function getStaticPaths() {
  const poems = await getCollection("poems");
  return poems.map((poem) => ({
    params: { slug: poem.slug },
    props: { poem },
  }));
}

const { poem } = Astro.props;
const { Content } = await poem.render();

const pageTitle = poem.data.title;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · 诗歌</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #f9f9f9;
        --card-bg: #ffffff;
        --text-main: #1a1a1a;
        --text-sub: #888888;
        --accent: #10b981;
        --border: #eeeeee;
        --radius: 24px;
        --shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
      }

      body {
        background: var(--bg);
        color: var(--text-main);
        font-family: -apple-system, system-ui, sans-serif;
        line-height: 1.8;
        padding: 20px;
      }

      .container { max-width: 700px; margin: 0 auto; padding-top: 40px; padding-bottom: 100px; }

      /* 顶部导航：Alex / 诗歌 / 标题 */
      .breadcrumb { 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        font-size: 14px;
        margin-bottom: 40px; 
      }
      .breadcrumb a { text-decoration: none; color: var(--text-main); font-weight: 700; }
      .breadcrumb .slash { opacity: 0.2; }
      .breadcrumb .current { color: var(--text-sub); }

      /* 诗歌详情卡片 */
      .poem-wrapper {
        background: var(--card-bg);
        padding: 60px 50px;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
      }

      header { margin-bottom: 50px; text-align: center; }
      .title { 
        font-family: 'Noto Serif SC', serif; 
        font-size: 2.5rem; 
        margin-bottom: 15px; 
        letter-spacing: 1px;
      }
      .meta { 
        font-size: 13px; 
        color: var(--text-sub); 
        display: flex; 
        justify-content: center; 
        gap: 15px;
        align-items: center;
      }
      .series-tag { color: var(--accent); font-weight: 700; }

      /* 诗歌正文样式 */
      .article-content {
        font-family: 'Noto Serif SC', serif;
        font-size: 1.15rem;
        color: #333;
        white-space: pre-wrap; /* 保留诗歌的换行 */
        text-align: center;    /* 诗歌通常居中对齐更有美感 */
        margin: 0 auto;
        max-width: 80%;
      }
      
      /* 适配 Markdown 渲染出的段落 */
      .article-content p { margin-bottom: 1.5em; }

      /* 底部返回按钮 */
      .footer-nav {
        margin-top: 50px;
        display: flex;
        justify-content: center;
      }
      .back-btn {
        padding: 10px 25px;
        border-radius: 30px;
        background: #f0f0f0;
        color: #666;
        text-decoration: none;
        font-size: 14px;
        transition: 0.3s;
        border: 1px solid transparent;
      }
      .back-btn:hover {
        background: var(--accent);
        color: white;
        transform: translateY(-2px);
      }

      @media (max-width: 600px) {
        .poem-wrapper { padding: 40px 20px; }
        .title { font-size: 1.8rem; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Alex</a>
        <span class="slash">/</span>
        <a href="/poems">诗歌</a>
        <span class="slash">/</span>
        <span class="current">{poem.data.title}</span>
      </nav>

      <article class="poem-wrapper">
        <header>
          <h1 class="title">{poem.data.title}</h1>
          <div class="meta">
            <span>{new Date(poem.data.date).toLocaleDateString('zh-CN')}</span>
            {poem.data.series && (
              <>
                <span style="opacity:0.3">|</span>
                <span class="series-tag"># {poem.data.series}</span>
              </>
            )}
          </div>
        </header>

        <div class="article-content">
          <Content />
        </div>
      </article>

      <div class="footer-nav">
        <a href="/poems" class="back-btn">← 返回诗歌列表</a>
      </div>
    </div>
  </body>
</html>
---
import { getCollection } from "astro:content";
import UltimateHome from "../components/UltimateHome";

// 获取本地内容库
const poemsAll = await getCollection("poems");
const photosAll = await getCollection("photos");

// 排除草稿
const poems = poemsAll.filter((p) => !p.data?.draft);
const photos = photosAll.filter((p) => !p.data?.draft);

// 提取所有系列
const seriesSet = new Set();
poems.forEach(p => p.data?.series && seriesSet.add(p.data.series));
photos.forEach(p => p.data?.series && seriesSet.add(p.data.series));

const profile = {
  name: "Alex",
  tagline: "写诗 / 摄影 / 记录",
  stats: [
    { label: "诗歌", count: poems.length },
    { label: "摄影", count: photos.length },
    { label: "系列", count: seriesSet.size }
  ]
};

// 整合并排序最新内容
const latestContent = [
  ...poems.map(p => ({ ...p, type: 'poems', typeLabel: '诗歌' })),
  ...photos.map(p => ({ ...p, type: 'photos', typeLabel: '摄影' }))
].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 8);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · 创作面板</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style is:global>
      body {
        margin: 0;
        padding: 0;
        background: #fbfbfd; /* 苹果风格背景色 */
        overflow-x: hidden;
      }
      /* 隐藏滚动条但保留功能 */
      ::-webkit-scrollbar { width: 0px; background: transparent; }
    </style>
  </head>
  <body>
    <UltimateHome 
      profile={profile} 
      latestContent={latestContent} 
      client:load 
    />
  </body>
</html>
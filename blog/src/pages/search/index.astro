---
// 逻辑部分为空，Pagefind 是客户端脚本
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>搜索 · Alex</title>
    <meta name="description" content="搜索 Alex 的诗歌与摄影内容。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        color-scheme: light dark;

        --bg-base: #f4f6f7;
        --bg-elevated: rgba(255, 255, 255, 0.76);
        --bg-elevated-strong: rgba(255, 255, 255, 0.88);

        --ambient-1: #afede3;
        --ambient-2: #e8f5ff;
        --ambient-3: #f4edff;
        --ambient-4: #dff3ef;

        --text-main: #1c1c1f;
        --text-sub: #6f737b;
        --text-muted: #9ca2aa;

        --accent: #79ddc9;
        --accent-strong: #56cbb1;
        --error: #ef4444;

        --border-soft: rgba(255, 255, 255, 0.62);
        --border-strong: rgba(255, 255, 255, 0.94);
        --border-faint: rgba(20, 24, 31, 0.06);

        --shadow-xs: 0 2px 10px rgba(17, 24, 39, 0.04);
        --shadow-sm: 0 8px 24px rgba(17, 24, 39, 0.06);
        --shadow-md: 0 18px 48px rgba(17, 24, 39, 0.09);
        --shadow-lg: 0 32px 80px rgba(17, 24, 39, 0.12);

        --radius-md: 24px;
        --radius-lg: 34px;
        --radius-xl: 42px;
        --radius-pill: 999px;

        --ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-base: #06070a;
          --bg-elevated: rgba(19, 23, 30, 0.58);
          --bg-elevated-strong: rgba(22, 27, 34, 0.78);

          --ambient-1: #0b5b4d;
          --ambient-2: #1a3758;
          --ambient-3: #33224a;
          --ambient-4: #123d3d;

          --text-main: #f4f5f7;
          --text-sub: #b3b8c1;
          --text-muted: #7e8590;

          --accent: #82e5d1;
          --accent-strong: #5ed6bc;

          --border-soft: rgba(255, 255, 255, 0.1);
          --border-strong: rgba(255, 255, 255, 0.18);
          --border-faint: rgba(255, 255, 255, 0.08);

          --shadow-xs: 0 2px 10px rgba(0, 0, 0, 0.28);
          --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.38);
          --shadow-md: 0 20px 52px rgba(0, 0, 0, 0.45);
          --shadow-lg: 0 36px 88px rgba(0, 0, 0, 0.58);
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 12% 16%, rgba(175, 237, 227, 0.42), transparent 30%),
          radial-gradient(circle at 82% 22%, rgba(188, 220, 255, 0.32), transparent 26%),
          radial-gradient(circle at 56% 84%, rgba(227, 217, 255, 0.22), transparent 28%),
          linear-gradient(180deg, var(--bg-base) 0%, color-mix(in srgb, var(--bg-base) 92%, white 8%) 100%);
        color: var(--text-main);
        font-family:
          -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        overflow: hidden;
      }

      .ambient-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.68;
        animation: floatBlob 18s ease-in-out infinite alternate;
      }

      .blob-1 {
        width: 52vw;
        height: 52vw;
        left: -14vw;
        top: -12vh;
        background: radial-gradient(circle, var(--ambient-1) 0%, transparent 70%);
      }

      .blob-2 {
        width: 48vw;
        height: 48vw;
        right: -12vw;
        top: 8vh;
        background: radial-gradient(circle, var(--ambient-2) 0%, transparent 72%);
        animation-delay: -4s;
      }

      .blob-3 {
        width: 42vw;
        height: 42vw;
        left: 24vw;
        bottom: -18vh;
        background: radial-gradient(circle, var(--ambient-3) 0%, transparent 72%);
        animation-delay: -8s;
      }

      .blob-4 {
        width: 36vw;
        height: 36vw;
        right: 18vw;
        bottom: -8vh;
        background: radial-gradient(circle, var(--ambient-4) 0%, transparent 72%);
        animation-delay: -12s;
      }

      @keyframes floatBlob {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(3%, 4%, 0) scale(1.04); }
        100% { transform: translate3d(-4%, 6%, 0) scale(0.96); }
      }

      .page {
        width: 100%;
        max-width: 920px;
        margin: 0 auto;
        padding: 24px 20px 96px;
      }

      .site-header {
        position: sticky;
        top: 16px;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        padding: 12px 16px 12px 18px;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-xs);
        backdrop-filter: blur(22px) saturate(180%);
        -webkit-backdrop-filter: blur(22px) saturate(180%);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 14px;
        font-weight: 800;
        color: white;
        background:
          linear-gradient(180deg, rgba(15, 18, 26, 0.92), rgba(25, 30, 40, 0.9));
        box-shadow:
          inset 0 0 0 2px rgba(255, 255, 255, 0.22),
          0 8px 24px rgba(17, 24, 39, 0.14);
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.15;
      }

      .brand-sub {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.15;
      }

      .nav-links {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
      }

      .nav-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        border-radius: var(--radius-pill);
        color: var(--text-sub);
        font-size: 14px;
        font-weight: 600;
        transition:
          color 0.28s var(--ease-soft),
          background 0.28s var(--ease-soft),
          transform 0.28s var(--ease-soft);
      }

      .nav-item:hover,
      .nav-item:focus-visible {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.34);
        transform: translateY(-1px);
        outline: none;
      }

      .hero-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.28)),
          color-mix(in srgb, var(--bg-elevated) 92%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(26px) saturate(180%);
        -webkit-backdrop-filter: blur(26px) saturate(180%);
        padding: 34px;
        margin-bottom: 18px;
      }

      .hero-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(140deg, rgba(255, 255, 255, 0.42) 0%, transparent 30%),
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.24), transparent 30%);
        pointer-events: none;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-strong);
        box-shadow: 0 0 14px rgba(86, 203, 177, 0.66);
      }

      .hero-title {
        font-family: "Noto Serif SC", serif;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        line-height: 1.05;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 10px;
      }

      .hero-text {
        font-size: 15px;
        color: var(--text-sub);
      }

      .search-box {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.52), rgba(255, 255, 255, 0.16)),
          color-mix(in srgb, var(--bg-elevated) 92%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        padding: 22px;
        margin-bottom: 18px;
      }

      .search-box::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent 30%),
          radial-gradient(circle at top right, rgba(175, 237, 227, 0.16), transparent 26%);
        pointer-events: none;
      }

      .search-input {
        position: relative;
        z-index: 1;
        width: 100%;
        padding: 16px 18px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.34);
        background: rgba(255, 255, 255, 0.46);
        color: var(--text-main);
        font-size: 16px;
        outline: none;
        transition:
          border-color 0.28s var(--ease-soft),
          box-shadow 0.28s var(--ease-soft),
          background 0.28s var(--ease-soft);
      }

      .search-input::placeholder {
        color: var(--text-muted);
      }

      .search-input:focus {
        background: rgba(255, 255, 255, 0.7);
        border-color: rgba(86, 203, 177, 0.34);
        box-shadow: 0 0 0 4px rgba(86, 203, 177, 0.1);
      }

      #hint {
        padding: 22px 6px 6px;
        color: var(--text-sub);
        font-size: 14px;
      }

      #list {
        display: grid;
        gap: 16px;
      }

      #list :global(.res-card) {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 18px;
        align-items: center;
        padding: 24px 26px;
        border-radius: 30px;
        text-decoration: none;
        color: inherit;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.18)),
          color-mix(in srgb, var(--bg-elevated) 90%, transparent);
        border: 1px solid var(--border-soft);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        transition:
          transform 0.34s var(--ease-soft),
          box-shadow 0.34s var(--ease-soft),
          border-color 0.34s var(--ease-soft),
          background 0.34s var(--ease-soft);
        animation: revealUp 0.56s var(--ease-soft) forwards;
      }

      #list :global(.res-card::before) {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent 30%),
          radial-gradient(circle at top right, rgba(175, 237, 227, 0.16), transparent 26%);
        pointer-events: none;
      }

      #list :global(.res-card:hover) {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
        border-color: var(--border-strong);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.2)),
          color-mix(in srgb, var(--bg-elevated-strong) 92%, transparent);
      }

      #list :global(.res-content) {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
      }

      #list :global(.res-tag) {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 700;
        color: var(--accent-strong);
        background: rgba(86, 203, 177, 0.1);
        border: 1px solid rgba(86, 203, 177, 0.14);
      }

      #list :global(.res-title) {
        font-family: "Noto Serif SC", serif;
        font-size: clamp(1.1rem, 3vw, 1.35rem);
        line-height: 1.3;
        font-weight: 700;
        color: var(--text-main);
        word-break: break-word;
      }

      #list :global(.res-arrow) {
        position: relative;
        z-index: 1;
        font-size: 1.35rem;
        color: var(--text-muted);
        transition:
          transform 0.28s var(--ease-soft),
          color 0.28s var(--ease-soft);
      }

      #list :global(.res-card:hover .res-arrow) {
        transform: translateX(4px);
        color: var(--accent-strong);
      }

      .error-text {
        color: var(--error);
      }

      .site-footer {
        margin-top: 42px;
        padding: 22px 6px 0;
        border-top: 1px solid var(--border-faint);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-copy {
        font-size: 13px;
        color: var(--text-muted);
      }

      .footer-links {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .footer-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sub);
      }

      .footer-link:hover,
      .footer-link:focus-visible {
        color: var(--text-main);
        outline: none;
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(10px);
        animation: revealUp 0.72s var(--ease-soft) forwards;
      }

      .delay-1 { animation-delay: 0.06s; }
      .delay-2 { animation-delay: 0.14s; }

      @keyframes revealUp {
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 700px) {
        .page {
          padding: 16px 16px 72px;
        }

        .site-header {
          top: 10px;
          flex-wrap: wrap;
          gap: 14px;
          padding: 10px 12px 10px 14px;
        }

        .brand-sub {
          display: none;
        }

        .nav-links {
          width: 100%;
          justify-content: flex-end;
        }

        .hero-card,
        .search-box {
          padding: 24px 18px;
        }

        #list :global(.res-card) {
          grid-template-columns: 1fr;
          align-items: flex-start;
          padding: 20px 20px 18px;
        }

        .site-footer {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-1"></div>
      <div class="ambient-blob blob-2"></div>
      <div class="ambient-blob blob-3"></div>
      <div class="ambient-blob blob-4"></div>
    </div>

    <div class="page">
      <header class="site-header reveal">
        <a href="/" class="brand" aria-label="返回首页">
          <div class="brand-mark">A</div>
          <div class="brand-text">
            <span class="brand-name">Alex</span>
            <span class="brand-sub">Search</span>
          </div>
        </a>

        <nav class="nav-links" aria-label="页面导航">
          <a class="nav-item" href="/">首页</a>
          <a class="nav-item" href="/poems/">诗歌</a>
          <a class="nav-item" href="/photos/">摄影</a>
        </nav>
      </header>

      <main>
        <section class="hero-card reveal delay-1">
          <span class="eyebrow">Search</span>
          <h1 class="hero-title">搜索</h1>
          <p class="hero-text">输入关键词，检索诗歌与摄影内容。</p>
        </section>

        <section class="search-box reveal delay-2">
          <input
            type="text"
            id="q"
            class="search-input"
            placeholder="输入关键词，搜索诗歌或摄影..."
            autocomplete="off"
          />
        </section>

        <div id="hint" class="reveal delay-2">正在连接搜索服务...</div>
        <div id="list"></div>
      </main>

      <footer class="site-footer reveal delay-2">
        <p class="footer-copy">Alex · Search</p>

        <div class="footer-links">
          <a href="/" class="footer-link">首页</a>
          <a href="/poems/" class="footer-link">诗歌</a>
          <a href="/photos/" class="footer-link">摄影</a>
        </div>
      </footer>
    </div>

    <script is:inline>
      const $q = document.querySelector("#q");
      const $list = document.querySelector("#list");
      const $hint = document.querySelector("#hint");

      let pagefind;

      async function initPagefind() {
        try {
          pagefind = await import("/pagefind/pagefind.js");
          await pagefind.options({ bundlePath: "/pagefind/" });
          $hint.innerText = "输入关键词，探索空间里的碎片";
        } catch (e) {
          $hint.innerHTML = `<span class="error-text">搜索功能在生产环境下可用，请执行 npm run build。</span>`;
        }
      }

      async function doSearch() {
        const query = $q.value.trim();

        if (!query) {
          $list.innerHTML = "";
          $hint.style.display = "block";
          $hint.innerText = "输入关键词，探索空间里的碎片";
          return;
        }

        if (!pagefind) await initPagefind();

        const search = await pagefind.search(query);

        if (search.results.length === 0) {
          $list.innerHTML = "";
          $hint.style.display = "block";
          $hint.innerText = "没有找到匹配的痕迹，换个词试试？";
          return;
        }

        $hint.style.display = "none";
        const results = await Promise.all(
          search.results.slice(0, 10).map((r) => r.data())
        );

        $list.innerHTML = results
          .map((r) => {
            const isPoem = r.url.includes("/poems/");
            const typeLabel = isPoem ? "诗歌" : "摄影";

            return `
              <a href="${r.url}" class="res-card">
                <div class="res-content">
                  <span class="res-tag">${typeLabel}</span>
                  <span class="res-title">${r.meta.title || "无标题碎片"}</span>
                </div>
                <span class="res-arrow">→</span>
              </a>
            `;
          })
          .join("");
      }

      $q.addEventListener("input", () => {
        clearTimeout(window.searchTimer);
        window.searchTimer = setTimeout(doSearch, 300);
      });

      initPagefind();
    </script>
  </body>
</html>
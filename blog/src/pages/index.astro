            className="relative z-10 flex h-[280px] w-[280px] md:h-[340px] md:w-[340px] items-center justify-center overflow-hidden rounded-[48px] bg-white shadow-[0_30px_100px_rgba(0,0,0,0.5)] border border-white/20"
            style={{ scale: boxScale, opacity: boxOpacity }}
          >
            {/* 昵称层 */}
            <motion.div 
              className="absolute inset-0 flex items-center justify-center"
              style={{ opacity: textOpacity, scale: textScale }}
            >
              <h1 className="font-serif text-5xl md:text-6xl font-bold tracking-tight text-black drop-shadow-sm">
                {profile.name}
              </h1>
            </motion.div>

            {/* LOVE 遮罩层 (完美还原原有逻辑，更丝滑) */}
            <motion.div 
              className="absolute inset-0 z-20"
              style={{ clipPath: clipPathString }}
            >
              <svg width="100%" height="100%" viewBox="0 0 340 340">
                <defs>
                  <mask id="love-mask-pro">
                    <rect width="100%" height="100%" fill="white" />
                    <text x="50%" y="50%" textAnchor="middle" dy=".35em" fontSize="85" fontWeight="900" fontFamily="-apple-system, sans-serif" letterSpacing="4" fill="black">
                      LOVE
                    </text>
                  </mask>
                </defs>
                {/* 使用要求的天蓝色进行覆盖 */}
                <rect width="100%" height="100%" fill="#afede3" mask="url(#love-mask-pro)" />
                {/* 内部高光质感 */}
                <rect width="100%" height="100%" fill="url(#gloss-gradient)" mask="url(#love-mask-pro)" mixBlendMode="overlay" opacity="0.5"/>
                <linearGradient id="gloss-gradient" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stopColor="white" stopOpacity="0.8"/>
                  <stop offset="100%" stopColor="white" stopOpacity="0"/>
                </linearGradient>
              </svg>
            </motion.div>
          </motion.div>

          {/* 滚动提示 */}
          <motion.div 
            className="absolute bottom-12 flex flex-col items-center gap-2"
            style={{ opacity: hintOpacity }}
          >
            <span className="text-xs font-medium uppercase tracking-widest text-slate-500">Scroll to initialize</span>
            <motion.div 
              animate={{ y: [0, 8, 0] }} 
              transition={{ duration: 2, repeat: Infinity, ease: "easeInOut" }}
              className="h-8 w-[1px] bg-gradient-to-b from-slate-500 to-transparent"
            />
          </motion.div>
        </div>
      </div>

      {/* 真实页面内容容器：挂载在滚动轨道之后，通过负 margin 往上提，使其与动画无缝衔接 */}
      <motion.div 
        className="relative z-40 -mt-[100vh] min-h-screen w-full bg-[#0a0a0c]"
        style={{ opacity: mainContentOpacity, y: mainContentY, scale: mainContentScale }}
      >
        <div className="flex w-full">

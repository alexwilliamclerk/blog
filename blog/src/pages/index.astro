                  <h3 className="text-lg font-semibold text-slate-100 mb-2 group-hover:text-[#afede3] transition-colors line-clamp-1">
                    {item.data.title}
                  </h3>
                  <div className="flex items-center justify-between text-xs text-slate-500 font-medium">
                    <span>Published: {new Date(item.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                    <span className="flex items-center gap-1 border border-white/10 rounded-md px-2 py-0.5 bg-black/20">
                      <Activity size={10} className="text-[#afede3]" /> {item.data.views.toLocaleString()} ops
                    </span>
                  </div>
                </div>
              </motion.a>
            ))}
          </AnimatePresence>
          {filteredContent.length === 0 && (
            <div className="col-span-full py-20 flex flex-col items-center justify-center text-slate-500">
              <Search size={32} className="mb-4 opacity-50" />
              <p>暂无相关内容数据</p>
            </div>
          )}
        </div>
      </div>
    </PremiumGlowCard>
  );
};



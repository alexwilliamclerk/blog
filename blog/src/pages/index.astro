---
import { getCollection } from "astro:content";

// 1. 获取内容数据
const poemsAll = await getCollection("poems");
const photosAll = await getCollection("photos");

// 过滤掉草稿
const poems = poemsAll.filter((p) => !p.data?.draft);
const photos = photosAll.filter((p) => !p.data?.draft);

// 统计逻辑
const seriesSet = new Set();
poems.forEach(p => p.data?.series && seriesSet.add(p.data.series));
photos.forEach(p => p.data?.series && seriesSet.add(p.data.series));

const profile = {
  name: "Alex",
  tagline: "写诗 / 摄影 / 记录",
  stats: [
    { label: "诗歌", count: poems.length },
    { label: "摄影", count: photos.length },
    { label: "系列", count: seriesSet.size }
  ]
};

// 合并最新的内容用于首页展示
const latestContent = [
  ...poems.map(p => ({ ...p, type: 'poems', typeLabel: '诗歌' })),
  ...photos.map(p => ({ ...p, type: 'photos', typeLabel: '摄影' }))
].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 6);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · 首页</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg-top: #afede3;       /* 天蓝色 */
        --bg-bottom: #ffffff;    /* 白色 */
        --card-bg: rgba(255, 255, 255, 0.6); /* 苹果风半透明白 */
        --text-main: #1d1d1f;    /* 苹果主黑 */
        --text-sub: #86868b;     /* 苹果次灰 */
        --accent: #afede3;       /* 主题点缀 */
        --border: rgba(255, 255, 255, 0.4);
        --radius: 24px;          
        --shadow: 0 8px 32px rgba(0, 0, 0, 0.04); 
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      /* 整体渐变背景：随页面滑动变白 */
      body {
        background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 1200px);
        background-repeat: no-repeat;
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* === 滚动动画区域 === */
      .scroll-track {
        height: 250vh; /* 提供滚动距离 */
        position: relative;
        z-index: 50;
      }

      .sticky-view {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
      }

      /* 白色基础方框 */
      .animation-box {
        width: 260px;
        height: 260px;
        background: #ffffff;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        transform: scale(var(--box-scale, 1));
        opacity: var(--box-opacity, 1);
        will-change: transform, opacity;
      }

      .alex-text {
        font-size: 44px;
        font-weight: 800;
        letter-spacing: 1px;
        color: var(--text-main);
        opacity: var(--alex-opacity, 1);
        transition: opacity 0.1s;
      }

      /* 浅蓝色遮罩与镂空的 LOVE */
      .love-cover {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* 通过 clip-path 实现从上向下滑动遮住的效果 */
        clip-path: inset(var(--cover-inset, 100%) 0 0 0);
        will-change: clip-path;
      }

      /* === 真实首页内容区域 === */
      .main-wrapper {
        position: relative;
        z-index: 10;
        max-width: 700px;
        margin: -50vh auto 0; /* 让主内容在动画结束前顺滑衔接 */
        padding: 40px 20px 100px;
      }

      header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
      .logo { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; }
      .avatar-sm { width: 32px; height: 32px; background: var(--text-main); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: bold;}
      .nav-links { display: flex; gap: 20px; }
      .nav-item { text-decoration: none; color: var(--text-sub); font-size: 14px; transition: color 0.2s; }
      .nav-item:hover { color: var(--text-main); }

      /* 毛玻璃卡片 */
      .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: var(--radius);
        padding: 35px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        margin-bottom: 30px;
      }

      .title { font-family: 'Noto Serif SC', serif; font-size: 2.2rem; margin-bottom: 8px; font-weight: 700; }
      .tagline { color: var(--text-sub); margin-bottom: 30px; font-size: 1.05rem;}

      /* 苹果风数据小组件 */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }
      .stat-item { 
        background: rgba(255,255,255,0.7); 
        border: 1px solid rgba(255,255,255,0.5);
        border-radius: 18px; 
        padding: 16px; 
        text-align: center; 
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .stat-item b { color: var(--text-main); font-size: 22px; font-weight: 700; }
      .stat-item span { color: var(--text-sub); font-size: 12px; font-weight: 500;}

      /* 苹果风分段控制器 (Tabs) */
      .tabs { 
        display: inline-flex; 
        background: rgba(220, 220, 225, 0.5); 
        padding: 4px; 
        border-radius: 20px; 
        margin-bottom: 25px; 
        backdrop-filter: blur(10px);
      }
      .tab {
        padding: 6px 20px; border-radius: 16px; color: var(--text-sub);
        text-decoration: none; font-size: 13px; font-weight: 600;
        transition: all 0.2s ease;
      }
      .tab.active { background: #fff; color: var(--text-main); box-shadow: 0 2px 8px rgba(0,0,0,0.06); }

      /* 文章列表 */
      .post-list { display: flex; flex-direction: column; gap: 15px; }
      .post-card {
        background: var(--card-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 22px 25px;
        border-radius: 20px;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .post-card:hover { transform: scale(1.015); background: #ffffff; box-shadow: var(--shadow); }
      .post-info .type { font-size: 12px; color: #10b981; font-weight: 700; margin-bottom: 6px; display: block; letter-spacing: 0.5px;}
      .post-info .post-title { font-size: 1.15rem; font-weight: 600; }
      .post-meta { text-align: right; color: var(--text-sub); font-size: 13px; font-weight: 500;}

      @media (max-width: 600px) {
        .animation-box { width: 220px; height: 220px; }
        .alex-text { font-size: 36px; }
        .stats-grid { grid-template-columns: 1fr; gap: 10px; }
      }
    </style>
  </head>
  <body>
    
    <div class="scroll-track">
      <div class="sticky-view">
        <div class="animation-box">
          <div class="alex-text">Alex</div>
          
          <div class="love-cover">
            <svg width="100%" height="100%" viewBox="0 0 260 260">
              <defs>
                <mask id="love-mask">
                  <rect width="100%" height="100%" fill="white" />
                  <text x="50%" y="50%" text-anchor="middle" dy=".35em" font-size="65" font-weight="900" font-family="-apple-system, sans-serif" letter-spacing="2" fill="black">LOVE</text>
                </mask>
              </defs>
              <rect width="100%" height="100%" fill="#afede3" mask="url(#love-mask)" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div class="main-wrapper" id="main-content">
      <header>
        <div class="logo">
          <div class="avatar-sm">A</div>
          <span>{profile.name}</span>
        </div>
        <nav class="nav-links">
          <a href="/about" class="nav-item">关于</a>
          <a href="/links" class="nav-item">友链</a>
          <a href="/search" class="nav-item">搜索</a>
        </nav>
      </header>

      <main>
        <section class="glass-card">
          <h1 class="title">{profile.name}</h1>
          <p class="tagline">{profile.tagline}</p>
          
          <div class="stats-grid">
            {profile.stats.map(s => (
              <div class="stat-item">
                <b>{s.count}</b>
                <span>{s.label}</span>
              </div>
            ))}
          </div>
        </section>

        <nav class="tabs">
          <a href="/" class="tab active">最近更新</a>
          <a href="/poems" class="tab">诗歌</a>
          <a href="/photos" class="tab">摄影</a>
        </nav>

        <div class="post-list">
          {latestContent.map(item => (
            <a href={`/${item.type}/${item.slug}`} class="post-card">
              <div class="post-info">
                <span class="type">{item.typeLabel}</span>
                <div class="post-title">{item.data.title}</div>
              </div>
              <div class="post-meta">
                <div>{new Date(item.data.date).toLocaleDateString('zh-CN')}</div>
              </div>
            </a>
          ))}
        </div>
      </main>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const track = document.querySelector('.scroll-track');
        const mainContent = document.getElementById('main-content');
        
        // 初始隐藏主内容区，避免透过动画区看到
        mainContent.style.opacity = '0';

        window.addEventListener('scroll', () => {
          if (!track) return;
          const rect = track.getBoundingClientRect();
          // 计算滚动进度 0 ~ 1
          const p = Math.max(0, Math.min(1, -rect.top / (rect.height - window.innerHeight)));
          
          // 阶段1: 浅蓝遮罩向下滑动覆盖 (0.1 -> 0.45)
          let p1 = Math.max(0, Math.min(1, (p - 0.1) / 0.35));
          // 阶段2: 整个盒子缩小并淡出 (0.7 -> 0.95)
          let p2 = Math.max(0, Math.min(1, (p - 0.7) / 0.25));

          // 应用 CSS 变量驱动动画
          track.style.setProperty('--cover-inset', `${(1 - p1) * 100}%`);
          track.style.setProperty('--alex-opacity', `${1 - (p1 * 1.5)}`); // 文本提前淡出
          track.style.setProperty('--box-scale', `${1 - (p2 * 0.15)}`);
          track.style.setProperty('--box-opacity', `${1 - p2}`);

          // 主页内容在动画快结束时淡入
          if (p > 0.8) {
            mainContent.style.opacity = `${(p - 0.8) / 0.2}`;
          } else {
            mainContent.style.opacity = '0';
          }
        });
      });
    </script>
  </body>
</html>